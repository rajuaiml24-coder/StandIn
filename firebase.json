{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "standin-5755d",
          "appId": "1:645644256889:android:a589f682d7cf08188d76a8",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "standin-5755d",
          "configurations": {
            "android": "1:645644256889:android:a589f682d7cf08188d76a8",
            "web": "1:645644256889:web:dda4379e887dd58c8d76a8"
          }
        }
      }
    }
  }
}
