rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
      match /attendance/{recordId} { allow read, write: if isOwner(uid); }
      match /organizationHistory/{orgId} { allow read, write: if isOwner(uid); }
    }

    match /organizations/{orgId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
      match /policyVersions/{versionId} { allow read: if signedIn(); allow write: if false; }
      match /followers/{uid} { allow read: if signedIn(); allow create, update, delete: if isOwner(uid); }
      match /members/{uid} { allow read: if isOwner(uid); allow write: if false; }
    }

    match /policyProposals/{proposalId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
